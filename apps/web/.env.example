# Base URL of the API (apps/api), e.g. http://localhost:3917. Without it the shelf keeps its own titles
# and the books open blank.
NEXT_PUBLIC_API_URL=
# The Supabase project whose Auth signs the API's tokens: the app signs in anonymously on first open.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
