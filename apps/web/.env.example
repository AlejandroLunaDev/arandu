# Base URL of the API (apps/api), e.g. http://localhost:3917. The landing's books read it from the browser; the app
# calls it only from this server.
NEXT_PUBLIC_API_URL=
# The Supabase project that proves the Google identity; the API opens its own session from it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The presentation video on the hero's TV: any YouTube link (watch, youtu.be, shorts; ?t= sets the start). Empty hides
# the play button. Read at build time, so a change needs a redeploy.
NEXT_PUBLIC_VIDEO_URL=
# Server only. The API answers only callers with this secret: the same value as the API's INTERNAL_API_SECRET.
INTERNAL_API_SECRET=
# Server only. 32 random bytes, base64 (openssl rand -base64 32): seals the session cookie.
SESSION_COOKIE_SECRET=
