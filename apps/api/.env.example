# Copy to apps/api/.env. Never commit the real values.
OPENROUTER_API_KEY=
# Supabase session pooler (IPv4, port 5432), e.g. postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
DATABASE_URL=
# The Supabase project: its Auth signs the tokens the API checks.
SUPABASE_URL=https://<project-ref>.supabase.co
# Browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000
# PORT=3000
