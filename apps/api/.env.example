# Copy to apps/api/.env. Never commit the real values.
OPENROUTER_API_KEY=
# OpenRouter model ids, comma-separated: the first answers, the rest are its fallbacks in order. Unset: Haiku 5.5.
# OPENROUTER_MODELS=
# Supabase session pooler (IPv4, port 5432), e.g. postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
DATABASE_URL=
# The Supabase project: its Auth proves the Google identity at sign-in.
SUPABASE_URL=https://<project-ref>.supabase.co
# The project's publishable key (sb_publishable_...), sent next to the user's token.
SUPABASE_PUBLISHABLE_KEY=
# Signs the API's access tokens; at least 32 characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Shared with the web's Next server (same value there); at least 32 characters.
INTERNAL_API_SECRET=
# Browser origins allowed to read the landing's books (GET only), comma-separated.
CORS_ORIGINS=http://localhost:3000
# PORT=3000
